# Copy to .env.local and fill in. Never commit real values.
# Supabase Dashboard -> Project Settings -> API

# Public: safe for the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret: server/scripts only (used by the seed script). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed to push migrations with the Supabase CLI (`supabase db push`)
SUPABASE_DB_PASSWORD=your-database-password
# Session-pooler connection string (Supabase Dashboard -> Connect). Needed for `npm run db:push`
# because the direct db.<ref>.supabase.co host is IPv6-only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-1-your-region.pooler.supabase.com:5432/postgres
